{
	"permissions": {
		"defaultMode": "acceptEdits",
		"allow": [
			"Bash(pnpm *)",
			"Bash(git *)",
			"Bash(gh *)",
			"Bash(node *)",
			"Bash(ls *)",
			"Bash(cat *)",
			"Bash(head *)",
			"Bash(tail *)",
			"Bash(wc *)",
			"Bash(grep *)",
			"Bash(find *)",
			"Bash(mkdir *)",
			"Bash(cp *)",
			"Bash(mv *)",
			"Bash(touch *)",
			"Bash(curl *)",
			"Bash(lsof *)",
			"Bash(kill *)",
			"Bash(open *)",
			"WebSearch",
			"WebFetch(domain:tanstack.com)",
			"WebFetch(domain:tailwindcss.com)",
			"WebFetch(domain:react.dev)",
			"WebFetch(domain:biomejs.dev)",
			"WebFetch(domain:vite.dev)",
			"WebFetch(domain:developer.mozilla.org)",
			"WebFetch(domain:github.com)",
			"mcp__playwright"
		],
		"deny": [
			"Read(.env*)",
			"Read(**/*.pem)",
			"Read(**/*.key)"
		]
	},
	"enableAllProjectMcpServers": true,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-fix.sh\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
						"timeout": 180,
						"statusMessage": "Running typecheck + lint…"
					}
				]
			}
		]
	}
}
