# Dependencies
node_modules

# Build output
dist
.output
.nitro
.vinxi

# TanStack Router plugin scratch dir
.tanstack

# TypeScript incremental build info (written by `tsc -b`)
*.tsbuildinfo

# Test & coverage
coverage

# Environment files
.env
.env.*
!.env.example

# Logs
*.log

# Editor & OS
.DS_Store
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# husky's generated helper scripts (regenerated by `pnpm prepare`)
.husky/_

# Local Claude Code settings (per-machine, not shared)
.claude/settings.local.json

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp

# Sanity: the build-time snapshot of the archive (written by scripts/pull-archive.ts),
# the Studio's build output and extracted schema, and the Blueprint's local stack link.
src/content/archive.sanity.json
studio/dist
studio/.sanity
studio/schema.json
.sanity
# The bundle `blueprints deploy` writes next to each function before uploading it.
functions/**/.build
